{
  "name": "Jekyll Theme Development",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.2-bullseye",
  
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "postCreateCommand": "gem install jekyll bundler",

  "forwardPorts": [4000],

  "customizations": {
    "vscode": {
      "extensions": [
        "rebornix.Ruby",
        "vscode-icons-team.vscode-icons"
      ]
    }
  }
}
